views:
  - type: table
    name: Table
    filters:
      and:
        - file.hasProperty("type")
    groupBy:
      property: type
      direction: ASC
    order:
      - file.name
      - type
      - tags
      - file.ctime
      - file.folder
    sort:
      - property: file.ctime
        direction: ASC
      - property: file.name
        direction: ASC
      - property: tags
        direction: ASC
    columnSize:
      note.type: 83
  - type: kanban
    name: Kanban
    groupBy:
      property: type
      direction: ASC
    groupOrder:
      - book
      - concept
      - fleeting
      - moc
      - project
      - puzzle
    order:
      - file.name
    columnWidth: 300
    imageAspectRatio: 0.25
