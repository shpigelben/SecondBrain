views:
  - type: table
    name: View
    filters:
      and:
        - type == "fleeting"
    order:
      - file.name
      - tags
    sort: []
    columnWidth: 300
    columnSize:
      file.name: 252
  - type: list
    name: List
    filters:
      and:
        - type == "fleeting"
    sort:
      - property: file.ctime
        direction: ASC
    markers: bullet
    indentProperties: false
