views:
  - type: table
    name: All MOCs
    filters:
      and:
        - type == "MOC"
    order:
      - file.name
      - file.mtime
      - file.ctime
      - file.size
    sort:
      - property: file.ctime
        direction: ASC
      - property: file.size
        direction: ASC
    image: note.cover
    imageAspectRatio: 0.3
    cardSize: 170
    imageFit: ""
    columnSize:
      file.name: 373
      file.mtime: 193
      file.ctime: 206
  - type: table
    name: Priority
    filters:
      and:
        - type == "MOC"
        - file.tags.contains("priority")
    imageAspectRatio: 0.3
    image: note.cover
  - type: table
    name: Research
    filters:
      and:
        - file.hasProperty("research")
    image: note.cover
    imageAspectRatio: 0.65
    cardSize: 350
  - type: cards
    name: Rafael
    filters:
      and:
        - file.tags.contains("rafael")
        - type == "MOC"
    image: note.cover
    cardSize: 180
    imageFit: ""
    imageAspectRatio: 0.6
  - type: table
    name: View
    filters:
      and:
        - file.hasProperty("MOC")
    order:
      - file.name
      - file.backlinks
