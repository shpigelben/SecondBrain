		{
			"id":"501bba116a75b82d",
			"styleAttributes":{"textAlign":"center"},
			"text":"# Vector Calculus\n1. Write about Bezier Curves and their relation to splines\n2.  insert math notes from complex analysis into obsidian",
			"type":"text",
			"x":3921,
