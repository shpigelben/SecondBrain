		{
			"id":"404c2a4350e092dc",
			"styleAttributes":{},
			"text":"# Classical Mechanics\n\n1. Specific impulse\n2. Orbits under constant force ([Solar Sail](2.%20Notes/Solar%20Sail.md))\n3. self gravitation",
			"type":"text",
			"x":-720,
			"y":-1860,
			"width":400,
