			"width":400,
			"height":180
		},
		{
			"id":"f79087cb6ddfb7f5",
			"styleAttributes":{},
			"text":"Questions for Stackexchange:\n1.  Would the equations of motion change in a curved space? Circular motion.\n2. Do all quantities stem from space and time? (Are we able to mesasure only space and time)",
			"type":"text",
			"x":4181,
			"y":-840,
			"width":480,
			"height":280
		},
		{
			"id":"f459f02bb9cac265",
			"styleAttributes":{"shape":"predefined-process","textAlign":"center"},
			"text":"# Topic of Interest By Priority\n\n1. Electrodynamics\n2. Optics & Photonics\n3. Thermodynamics\n4. Dynamical Systems\n5. Atomic & Molecular Physics\n6. Stochastic Processes\n7. Chemical Processes\n8. Special Relativity\n9. Hydrodynamics",
			"type":"text",
			"x":3821,
			"y":-1522,
			"width":400,
			"height":505,
			"color":"3"
		},
		{
			"id":"e80c140ac848e3c3",
			"lockedHeight":true,
			"styleAttributes":{"shape":"pill","textAlign":"center"},
			"text":"$$\n\\begin{align}\n\\delta S = \\delta \\int\\limits \\mathcal{L} \\, dt &=\\delta \\int\\limits (K-V) \\, dt \\stackrel{!}{=}0  \\\\\n&\\Downarrow \\\\\n\\delta \\int\\limits K \\, dt &= \\delta \\int\\limits V \\, dt \n\\end{align}\n$$\n",
			"type":"text",
			"x":4341,
			"y":-1522,
