views:
  - type: table
    name: Physics
    filters:
      and:
        - type == "moc"
        - discipline.contains("physics")
    order:
      - file.name
      - discipline
      - field
    columnSize:
      file.name: 393
      note.discipline: 156
      note.field: 380
  - type: table
    name: Math
    filters:
      and:
        - type == "moc"
        - discipline.contains("math")
  - type: table
    name: Engineering
    filters:
      and:
        - type == "moc"
        - discipline.contains("engineering")
  - type: table
    name: MOCs
    filters:
      and:
        - type == "moc"
    order:
      - file.name
      - discipline
      - field
    sort:
      - property: discipline
        direction: ASC
    columnSize:
      note.discipline: 157
      note.field: 237
